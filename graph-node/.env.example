# Aura connection. Same instance the dashboard and agent read.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Root of instrument output on the share drive.
SOURCE_ROOT=X:\peakFit

# S3, for the raw data (spec.md 5g). Optional: without S3_BUCKET a rebuild
# still runs, it just does not upload. The key here belongs to the
# write-only `cataverse-uploader` IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=
