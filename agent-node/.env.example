# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Neo4j (same AuraDB instance the dashboard reads) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=xxxxxxxx
NEO4J_PASSWORD=
NEO4J_DATABASE=xxxxxxxx

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Context window. Ollama's default is 4096, which an agent outgrows quickly once
# schema + tool results accumulate. Bigger costs VRAM (KV cache) on top of the
# model itself — on a 12GB card holding qwen3:14b (~9.6GB) there is roughly
# 2.4GB of headroom, so raising this too far will spill to CPU and crawl.
# If you need a long context, try an 8B model instead.
OLLAMA_NUM_CTX=8192

# Emit a separate reasoning stream before answering (qwen3 supports it).
# Usually better Cypher; slower, and it consumes context.
OLLAMA_THINK=false

# --- Agent guardrails ---
AGENT_MAX_ROWS=50
AGENT_MAX_ITERATIONS=8
